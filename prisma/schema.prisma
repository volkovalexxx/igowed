generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  VENDOR
  ADMIN
}

enum DisplayMode {
  VERTICAL
  HORIZONTAL
  SQUARE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor           Vendor?
  events           Event[]
  bookings         Booking[]
  favorites        Favorite[]
  shortlist        ShortlistItem[]
  reviews          Review[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
}

model Event {
  id             String    @id @default(cuid())
  userId         String
  eventType      String
  title          String
  eventDate      DateTime?
  eventTime      String?
  country        String?
  city           String?
  brideName      String?
  groomName      String?
  guestMin       Int?
  guestMax       Int?
  budgetMin      Int?
  budgetMax      Int?
  budgetCurrency String    @default("BYN")
  format         String?
  atmospheres    String[]  @default([])
  notes          String?   @db.Text
  coverUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskLists        EventTaskList[]
  guests           EventGuest[]
  budgetCategories EventBudgetCategory[]
  timelines        EventTimeline[]
  vendors          EventVendor[]

  @@index([userId])
  @@index([eventDate])
}

model EventTaskList {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tasks EventTask[]

  @@index([eventId])
}

model EventTask {
  id        String    @id @default(cuid())
  listId    String
  title     String
  priority  String    @default("medium")
  deadline  DateTime?
  status    String    @default("open")
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  list EventTaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([status])
}

model EventGuest {
  id                 String   @id @default(cuid())
  eventId            String
  fullName           String
  rsvpStatus         String   @default("pending")
  side               String   @default("bride")
  needsTransfer      Boolean  @default(false)
  needsAccommodation Boolean  @default(false)
  comment            String?  @db.Text
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([rsvpStatus])
}

/// Подрядчик, занятый на мероприятии. Роль повторяет слот на странице мероприятия.
model EventVendor {
  id        String   @id @default(cuid())
  eventId   String
  vendorId  String
  role      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
}

model EventBudgetCategory {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items EventBudgetItem[]

  @@index([eventId])
}

model EventBudgetItem {
  id         String   @id @default(cuid())
  categoryId String
  title      String
  cost       Int      @default(0)
  paid       Int      @default(0)
  currency   String   @default("BYN")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category EventBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model EventTimeline {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries EventTimelineEntry[]

  @@index([eventId])
}

model EventTimelineEntry {
  id           String   @id @default(cuid())
  timelineId   String
  startTime    String
  endTime      String
  title        String
  location     String?
  participants String[] @default([])
  comment      String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timeline EventTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  ownerType   String
  ownerId     String
  objectKey   String   @unique
  publicUrl   String
  fileName    String
  contentType String
  sizeBytes   Int
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerType, ownerId])
  @@index([status])
}

model Vendor {
  id        String  @id @default(cuid())
  userId    String  @unique
  slug      String  @unique
  firstName String
  lastName  String
  username  String  @unique
  bio       String? @db.Text
  avatar    String?
  isPro     Boolean @default(false)

  country String   @default("Беларусь")
  cities  String[]

  phone        String?
  phone2       String?
  website      String?
  instagram    String?
  address      String?
  lat          Float?
  lng          Float?
  workingHours String?

  businessType String?
  bankDetails  String? @db.Text

  languages      String[]    @default(["Русский"])
  galleryDisplay DisplayMode @default(VERTICAL)
  cardDisplay    DisplayMode @default(VERTICAL)

  rating       Float  @default(0)
  reviewCount  Int    @default(0)
  pricePerHour Int?
  currency     String @default("RUB")

  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        VendorService[]
  specializations Specialization[]
  photos          Photo[]
  reviews         Review[]
  favorites       Favorite[]
  shortlistedBy   ShortlistItem[]
  bookings        Booking[]
  events          EventVendor[]
  products        Product[]
  bannerAds       BannerAd[]
}

model Category {
  id    String  @id @default(cuid())
  slug  String  @unique
  name  String
  icon  String?
  image String?
  order Int     @default(0)

  services       Service[]
  vendorServices VendorService[]
  products       Product[]
}

/// Отдельная позиция подрядчика с галереей и произвольными характеристиками (платье, авто, торт).
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  vendorId    String
  categoryId  String?
  title       String
  description String?  @db.Text
  price       Int?
  currency    String   @default("RUB")
  unit        String?
  pricePrefix Boolean  @default(false)
  ctaLabel    String   @default("Связаться")
  city        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category?          @relation(fields: [categoryId], references: [id])
  photos     ProductPhoto[]
  attributes ProductAttribute[]

  @@index([vendorId])
  @@index([categoryId])
}

model ProductPhoto {
  id        String @id @default(cuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  label     String
  value     String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Service {
  id         String  @id @default(cuid())
  categoryId String
  slug       String  @unique
  name       String
  image      String?
  order      Int     @default(0)

  category       Category        @relation(fields: [categoryId], references: [id])
  vendorServices VendorService[]
}

model VendorService {
  id          String  @id @default(cuid())
  vendorId    String
  categoryId  String
  serviceId   String?
  price       Int?
  currency    String  @default("RUB")
  unit        String  @default("час")
  description String? @db.Text

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])

  @@unique([vendorId, serviceId])
}

model Specialization {
  id       String @id @default(cuid())
  vendorId String
  name     String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  vendorId  String
  url       String
  thumb     String?
  order     Int      @default(0)
  isAvatar  Boolean  @default(false)
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String
  eventId   String?
  rating    Int
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([userId, eventId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
}

model ShortlistItem {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  vendorId  String
  date      DateTime?
  message   String?       @db.Text
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  text       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     String   @db.Text
  image       String?
  category    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model VideoCard {
  id       String  @id @default(cuid())
  title    String
  thumb    String?
  videoUrl String?
  order    Int     @default(0)
}

model BannerAd {
  id       String  @id @default(cuid())
  vendorId String?
  title    String
  image    String
  link     String?
  position Int     @default(0)
  isActive Boolean @default(true)

  vendor Vendor? @relation(fields: [vendorId], references: [id])
}
